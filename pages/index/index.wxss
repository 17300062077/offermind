ze:56rpx;margin-bottom:16rpx}.slogan-title{display:block;font-size:56rpx;font-weight:800;color:#fff;margin-bottom:16rpx;letter-spacing:2rpx}.slogan-subtitle{font-size:28rpx;color:#8a8a9a}.daily-tip{display:flex;align-items:flex-start;gap:16rpx;border-radius:20rpx;padding:24rpx}.tip-icon{font-size:32rpx;flex-shrink:0}.tip-content{flex:1}.tip-label{display:block;font-size:22rpx;color:#3b82f6;margin-bottom:8rpx}.tip-text{font-size:26rpx;color:#d1d5db;line-height:1.6}.tip-refresh{width:48rpx;height:48rpx;border-radius:50%;background:rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center;flex-shrink:0}.tip-refresh:active{background:rgba(255,255,255,.15)}.refresh-icon{font-size:24rpx}.quick-actions{padding:0 32rpx;display:flex;flex-direction:column;gap:20rpx;margin-bottom:48rpx}.action-card{display:flex;align-items:center;border-radius:24rpx;padding:32rpx;transition:all .3s ease}.action-card:active{transform:scale(.98)}.action-card.primary{background:linear-gradient(135deg,#3b82f6 0%,#1d4ed8 100%)}.action-card.secondary{background:rgba(255,255,255,.06);border:1rpx solid rgba(255,255,255,.08)}.action-icon-wrap{width:80rpx;height:80rpx;border-radius:20rpx;display:flex;align-items:center;justify-content:center;margin-right:20rpx}.action-icon-wrap.primary{background:rgba(255,255,255,.2)}.action-icon-wrap.secondary{background:rgba(255,255,255,.08)}.action-emoji{font-size:40rpx}.action-info{flex:1}.action-title{display:block;font-size:30rpx;font-weight:600;color:#fff;margin-bottom:6rpx}.action-desc{font-size:24rpx;color:rgba(255,255,255,.7)}.action-arrow{width:48rpx;height:48rpx;display:flex;align-items:center;justify-content:center}.arrow{font-size:32rpx;color:rgba(255,255,255,.8)}.features-section{padding:0 32rpx;margin-bottom:48rpx}.section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx}.section-title{font-size:32rpx;font-weight:600;color:#fff}.section-desc{font-size:24rpx;color:#8a8a9a}.section-more{font-size:2