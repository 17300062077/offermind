<view class="page-container"><view class="background-gradient"></view><view class="nav-bar glass-card"><view class="nav-back" bindtap="{{a}}"><text class="back-icon">‹</text></view><view class="nav-info"><text class="nav-title">{{b}}</text><text class="nav-subtitle">{{c}}</text></view><view class="nav-actions"><view class="nav-action" bindtap="{{d}}"><text class="action-icon">📊</text></view><view class="nav-action" bindtap="{{e}}"><text class="action-icon">⋯</text></view></view></view><scroll-view class="chat-container" scroll-y scroll-into-view="{{j}}" scroll-with-animation bindscrolltolower="{{k}}"><view class="chat-messages"><view wx:if="{{f}}" class="welcome-message"><view class="welcome-avatar">🤖</view><text class="welcome-text">准备好开始面试了吗？</text><text class="welcome-desc">我将根据{{g}}的特点为你提问</text></view><view wx:for="{{h}}" wx:for-item="message" wx:key="g" id="{{message.h}}" class="message-item"><view wx:if="{{message.a}}" class="message-assistant"><view class="avatar-wrapper assistant"><text class="avatar-emoji">🤖</text></view><view class="bubble-wrapper"><view class="bubble assistant"><text class="bubble-content">{{message.b}}</text><view wx:if="{{message.c}}" class="typing-indicator"><view class="typing-dot"></view><view class="typing-dot"></view><view class="typing-dot"></view></view></view><text class="message-time">{{message.d}}</text></view></view><view wx:else class="message-user"><view class="bubble-wrapper"><view class="bubble user"><text class="bubble-content">{{message.e}}</text></view><text class="message-time">{{message.f}}</text></view><view class="avatar-wrapper user"><text class="avatar-emoji">👤</text></view></view></view><view wx:if="{{i}}" class="thinking-message"><view class="avatar-wrapper assistant"><text class="avatar-emoji">🤖</text></view><view class="thinking-bubble"><view class="thinking-content"><text class="thinking-text">AI正在思考中...</text><view class="thinking-dots"><view class="thinking-dot"></view><view class="thinking-dot"></view><view class="thinking-dot"></view></view></view></view></view></view></scroll-view><view class="input-area glass-card"><view wx:if="{{l}}" class="score-badge"><view class="score-main"><view class="{{['score-circle', n]}}"><text class="score-value">{{m}}</text></view><view class="score-info"><text class="score-label">本轮评分</text><text class="score-hint">点击查看详情</text></view></view><view class="score-actions"><view class="score-action" bindtap="{{o}}"><text class="action-icon">🔄</text><text class="action-text">重新回答</text></view><view class="score-action primary" bindtap="{{p}}"><text class="action-icon">📋</text><text class="action-text">查看详情</text></view></view></view><view class="input-tools"><view class="{{['tool-btn', r && 'active']}}" bindtap="{{s}}"><text class="tool-icon">{{q}}</text></view><view class="tool-btn" bindtap="{{t}}"><text class="tool-icon">🗑️</text></view></view><view class="input-wrapper"><input class="input-field" placeholder="{{v}}" adjust-position="{{true}}" confirm-type="send" bindconfirm="{{w}}" disabled="{{x}}" value="{{y}}" bindinput="{{z}}"/><view class="{{['send-btn', A && 'active']}}" bindtap="{{B}}"><text class="send-icon">➤</text></view></view></view><view wx:if="{{C}}" class="modal-overlay" bindtap="{{N}}"><view class="score-modal glass-card" catchtap="{{M}}"><view class="modal-header"><text class="modal-title">面试评价</text><view class="modal-close" bindtap="{{D}}"><text class="close-icon">✕</text></view></view><view class="modal-content"><view class="score-summary"><view class="total-score"><text class="score-number" style="{{'color:' + F}}">{{E}}</text><text class="score-label">综合评分</text><text class="score-level">{{G}}</text></view><view class="score-breakdown"><view wx:for="{{H}}" wx:for-item="item" wx:key="f" class="score-item"><view class="score-item-header"><text class="score-item-name">{{item.a}}</text><text class="score-item-value" style="{{'color:' + item.c}}">{{item.b}}</text></view><view class="score-bar"><view class="score-bar-track"></view><view class="score-bar-fill" style="{{'width:' + item.d + ';' + ('background:' + item.e)}}"></view></view></view></view></view><view class="evaluation-section"><text class="section-title">面试官评价</text><view class="evaluation-card"><text class="evaluation-text">{{I}}</text></view></view><view class="suggestions-section"><text class="section-title">改进建议</text><view wx:for="{{J}}" wx:for-item="suggestion" wx:key="c" class="suggestion-item"><view class="suggestion-number">{{suggestion.a}}</view><text class="suggestion-text">{{suggestion.b}}</text></view></view></view><view class="modal-footer"><view class="modal-btn secondary" bindtap="{{K}}"><text class="btn-text">继续面试</text></view><view class="modal-btn primary" bindtap="{{L}}"><text class="btn-text">结束面试</text></view></view></view></view></view>