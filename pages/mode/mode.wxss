.page-container{min-height:100vh;background:#0a0a0f;position:relative}.background-gradient{position:fixed;top:0;left:0;right:0;bottom:0;background:radial-gradient(ellipse at top,rgba(59,130,246,.15) 0%,transparent 50%),radial-gradient(ellipse at bottom,rgba(139,92,246,.1) 0%,transparent 50%);pointer-events:none}.glass-card{background:rgba(26,26,36,.6);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1rpx solid rgba(255,255,255,.06)}.nav-bar{position:fixed;top:0;left:0;right:0;z-index:100;height:100rpx;padding-top:var(--status-bar-height, 44px);display:flex;align-items:center;justify-content:space-between;padding-left:24rpx;padding-right:24rpx}.nav-back{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;border-radius:16rpx;background:rgba(255,255,255,.08)}.nav-back:active{background:rgba(255,255,255,.15)}.back-icon{font-size:48rpx;color:#fff;font-weight:300}.nav-info{flex:1;text-align:center}.nav-title{display:block;font-size:32rpx;font-weight:600;color:#fff}.nav-subtitle{font-size:22rpx;color:#8a8a9a}.nav-placeholder{width:64rpx}.content-wrapper{position:relative;z-index:1;height:100vh;padding-top:calc(var(--status-bar-height, 44px) + 120rpx)}.section-header{padding:0 32rpx;margin-bottom:40rpx}.section-title{display:block;font-size:36rpx;font-weight:700;color:#fff;margin-bottom:12rpx}.section-desc{font-size:26rpx;color:#8a8a9a}.modes-grid{padding:0 32rpx;display:flex;flex-direction:column;gap:24rpx}.mode-card{position:relative;border-radius:24rpx;padding:32rpx;overflow:hidden;transition:all .35s cubic-bezier(.4,0,.2,1);animation:slideUp .5s ease-out forwards;opacity:0}.mode-card:active{transform:scale(.98);background:rgba(255,255,255,.08)}.mode-card.animate-delay-1{animation-delay:.1s}.mode-card.animate-delay-2{animation-delay:.2s}.mode-card.animate-delay-3{animation-delay:.3s}.mode-card.animate-delay-4{animation-delay:.4s}@keyframes slideUp{0%{opacity:0;transform:translateY(30rpx)}to{opacity:1;transform:translateY(0)}}.mode-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx}.mode-icon{width:100rpx;height:100rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center}.icon-text{font-size:52rpx}.mode-badge{padding:10rpx 24rpx;border-radius:24rpx;font-size:22rpx;font-weight:600}.badge-text{font-size:inherit}.mode-body{margin-bottom:20rpx}.mode-name{display:block;font-size:34rpx;font-weight:700;color:#fff;margin-bottom:10rpx}.mode-desc{display:block;font-size:26rpx;color:#a1a1aa;line-height:1.5}.mode-footer{display:flex;align-items:center;justify-content:space-between}.mode-tags{display:flex;gap:12rpx;flex-wrap:wrap}.mode-tag{font-size:22rpx;color:#8a8a9a;background:rgba(255,255,255,.06);padding:8rpx 20rpx;border-radius:20rpx}.mode-arrow{width:52rpx;height:52rpx;border-radius:50%;background:rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center}.mode-card:active .mode-arrow{background:rgba(255,255,255,.15)}.arrow-icon{font-size:28rpx;color:#fff}.mode-accent{position:absolute;top:0;left:0;width:6rpx;height:100%;border-radius:3rpx 0 0 3rpx}.tips-section{margin:40rpx 32rpx;border-radius:20rpx;padding:28rpx;display:flex;align-items:flex-start;gap:20rpx}.tips-icon{font-size:36rpx;flex-shrink:0}.tips-content{flex:1}.tips-title{display:block;font-size:28rpx;font-weight:600;color:#fff;margin-bottom:8rpx}.tips-text{font-size:24rpx;color:#a1a1aa;line-height:1.5}.footer-space{height:60rpx}
